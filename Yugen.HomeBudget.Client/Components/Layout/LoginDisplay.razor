@using Microsoft.AspNetCore.Components.Authorization
@using Yugen.HomeBudget.Shared.Contants

<AuthorizeView>
	<Authorized>
		<BarLink>
			@if (_identityName != null)
			{
				<Figure Size="FigureSize.Is48x48">
					<FigureImage Source="@_image" AlternateText="Avatar" Rounded />
				</Figure>

				<Text> Hello @_identityName! </Text>

				<Button Color="Color.Danger" @onclick="BeginLogOut">
					<Icon Name="IconName.ArrowDown" />
					Sign out
				</Button>
			}
		</BarLink>
	</Authorized>
	<NotAuthorized>
		<BarLink>
			<Button Color="Color.Light"
					Type="ButtonType.Link"
					To="@PageConstants.RegisterUrl">
				<Icon Name="IconName.PlusSquare" />
				Register
			</Button>
			<Button Color="Color.Light"
					Type="ButtonType.Link"
					To="@PageConstants.LoginUrl">
				<Icon Name="IconName.ArrowUp" />
				Log in
			</Button>
		</BarLink>
	</NotAuthorized>
</AuthorizeView>
