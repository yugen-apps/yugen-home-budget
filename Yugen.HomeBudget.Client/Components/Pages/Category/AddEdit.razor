@attribute [Route(PageConstants.CategoryAddUrl)]
@attribute [Route(PageConstants.CategoryEditUrl)]
@using Microsoft.AspNetCore.Authorization
@using Yugen.HomeBudget.Client.Components
@using Yugen.HomeBudget.Client.Components.Shared
@using Yugen.HomeBudget.Client.Models
@using Yugen.HomeBudget.Client.ViewModels.Category
@using Yugen.HomeBudget.Shared.Contants
@using Yugen.HomeBudget.Shared.Helpers
@using Yugen.HomeBudget.Shared.Models.Category
@inject CategoryAddEditViewModel ViewModel

<TitleComponent PageTitle="@PageConstants.CategoryTitle"
                Title="@PageHelper.AddEditTitle(PageConstants.CategoryTitle, Id)"
                Breadcrumb="@PageConstants.CategoryTitle" />

<Row>
    <Column ColumnSize="ColumnSize.Is12">
        @if (ViewModel.Category != null)
        {
            <Validations @ref="ViewModel.validations" Mode="ValidationMode.Auto" ValidateOnLoad="false">
                @* <Blazorise.ValidationSummary Label="Following error occurs..." /> *@

                <Card Margin="Margin.Is4.FromBottom"
                      Shadow="Shadow.Default">
                    <CardHeader>
                        *
                    </CardHeader>

                    <CardBody>
                        <Validation Validator="ValidationRule.IsNotEmpty">
                            <Field>
                                <FieldLabel RequiredIndicator>Title</FieldLabel>
                                <TextEdit Autofocus Placeholder="Title" @bind-Text="@ViewModel.Category.Title" />
                            </Field>
                        </Validation>
                        <Field>
                            <FieldLabel>Icon</FieldLabel>
                            <Button Color="Color.Primary"
                                    Clicked="@ViewModel.OpenIconsPopup">
                                <Icon Name="@ViewModel.Category.Icon"
                                      IconSize="IconSize.Large" />
                            </Button>
                        </Field>

                        <Heading Size="HeadingSize.Is6">
                            Sub Categories
                        </Heading>
                        <DataGrid TItem="SubCategoryDto"
                                  Data="@ViewModel.Category?.SubCategoriesDto"
                                  RowRemoving="@ViewModel.OnRowRemoving"
                                  Editable
                                  UseValidation
                                  Responsive>
                            <DataGridCommandColumn DeleteCommandAllowed="true">
                                <NewCommandTemplate>
                                    <Button Color="Color.Primary"
                                            Clicked="@context.Clicked">
                                        <Icon Name="IconName.Add" />
                                    </Button>
                                </NewCommandTemplate>
                                <EditCommandTemplate>
                                    <Button Color="Color.Warning"
                                            Clicked="@context.Clicked">
                                        <Icon Name="IconName.Edit" />
                                    </Button>
                                </EditCommandTemplate>
                                <DeleteCommandTemplate>
                                    <Button Color="Color.Danger"
                                            Clicked="@context.Clicked">
                                        <Icon Name="IconName.Delete" />
                                    </Button>
                                </DeleteCommandTemplate>
                            </DataGridCommandColumn>
                            <DataGridColumn Field="@nameof(SubCategoryDto.Title)" Caption="@nameof(SubCategoryDto.Title)" Editable>
                                <EditTemplate>
                                    <Validation Validator="ValidationRule.IsNotEmpty">
                                        <TextEdit Text="@((string)context.CellValue)" TextChanged="(value => context.CellValue = value)" />
                                    </Validation>
                                </EditTemplate>
                            </DataGridColumn>
                        </DataGrid>
                    </CardBody>

                    <CardFooter>
                        <Button Color="Color.Primary"
                                Clicked="@ViewModel.OnSubmit">
                            Save
                        </Button>
                        <Button Color="Color.Warning"
                                Clicked="@ViewModel.CancelAsync">
                            Cancel
                        </Button>
                        <CardText>
                            <Alert Color="Color.Danger" @bind-Visible="@ViewModel.IsAlertVisible">
                                <AlertDescription>
                                    @ViewModel.Error
                                </AlertDescription>
                                <CloseButton />
                            </Alert>
                        </CardText>

                    </CardFooter>
                </Card>

            </Validations>
        }

        <Modal @bind-Visible="@ViewModel.ShowIconsPopup">
            <ModalContent Centered>
                <ModalHeader>
                    <ModalTitle>Add</ModalTitle>
                    <CloseButton />
                </ModalHeader>
                <ModalBody>
                    @foreach (var icon in ViewModel.IconList)
                    {
                        <Button Color="@ViewModel.IsActive(icon)"
                                Clicked="() => ViewModel.AddIcon(icon)">
                            <Icon IconSize="@IconSize.Large"
                                  Name="icon" />
                        </Button>
                    }
                </ModalBody>
                <ModalFooter>
                    <Button Color="Color.Secondary"
                            Clicked="ViewModel.SaveIcon">
                        Save
                    </Button>
                </ModalFooter>
            </ModalContent>
        </Modal>

    </Column>
</Row>
