@if (TotalPages > 0)
{
    <div class="right table-pagination">
        <ul class="d-flex justify-content-end align-items-center">
            <li class="ms-2">
                @if (!IsFirstPage)
                {
                    <a @onclick="@(() => OnClick.InvokeAsync(1))">
                        <i class="bi bi-chevron-double-left" aria-hidden="true"></i>
                    </a>
                }
            </li>
            <li class="ms-2">
                @if (HasPreviousPage)
                {
                    <a @onclick="@(() => OnClick.InvokeAsync(PreviousPage))">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </a>
                }
            </li>
            <li class="ms-2">
                <a href="#" class="active px-3">
                    @($"{PageIndex}/{TotalPages}")
                </a>
            </li>
            <li class="ms-2">
                @if (HasNextPage)
                {
                    <a @onclick="@(() => OnClick.InvokeAsync(NextPage))">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                }
            </li>
            <li class="ms-2">
                @if (!IsLastPage)
                {
                    <a @onclick="@(() => OnClick.InvokeAsync(TotalPages))">
                        <i class="bi bi-chevron-double-right" aria-hidden="true"></i>
                    </a>
                }
            </li>
        </ul>
    </div>
}
