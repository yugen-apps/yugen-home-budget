@using Yugen.HomeBudget.Shared.Models
@using Yugen.HomeBudget.Shared
@using System.Reflection
@using Yugen.HomeBudget.Shared.Contants

<aside class="sidebar-nav-wrapper @NavMenuCssClass">
    <nav class="sidebar-nav">
        <ul>
            <li class="nav-item @GetActive("", NavLinkMatch.All)">
                <NavLink href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-fill" aria-hidden="true"></span>Home
                </NavLink>
            </li>
            <span class="divider"><hr /></span>
            <li class="nav-item @GetActive(PageConstants.Category, NavLinkMatch.Prefix)">
                <NavLink href="@PageConstants.Category" Match="NavLinkMatch.Prefix">
                    <span class="bi bi-list" aria-hidden="true"></span>@PageConstants.Category
                </NavLink>
            </li>
            <li class="nav-item @GetActive(PageConstants.Expense, NavLinkMatch.Prefix)">
                <NavLink href="@PageConstants.Expense" Match="NavLinkMatch.Prefix">
                    <span class="bi bi-list" aria-hidden="true"></span>@PageConstants.Expense
                </NavLink>
            </li>
        </ul>
    </nav>
</aside>