<aside class="sidebar-nav-wrapper @NavMenuCssClass">
    <nav class="sidebar-nav">
        <ul>
            <li class="nav-item">
                <a href="">
                    <span class="bi bi-house-fill"> Home</span>
                </a>
            </li>
            <span class="divider"><hr /></span>
            <li class="nav-item">
                <a href="@PageHelper.ListHref(PageList.Category)">
                    <span class="bi bi-list"></span> @PageList.Categories
                </a>
            </li>
            <li class="nav-item">
                <a href="@PageHelper.ListHref(PageList.Expense)">
                    <span class="bi bi-list"></span> @PageList.Expenses
                </a>
            </li>
        </ul>
    </nav>
</aside>

