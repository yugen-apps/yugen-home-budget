@using Yugen.HomeBudget.Shared.Models
@using Yugen.HomeBudget.Shared.Enums
@using Yugen.HomeBudget.Shared
@using System.Reflection

<aside class="sidebar-nav-wrapper @NavMenuCssClass">
    <nav class="sidebar-nav">
        <ul>
            <li class="nav-item @GetActive("", NavLinkMatch.All)">
                <NavLink href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-fill" aria-hidden="true"></span>Home
                </NavLink>
            </li>
            <span class="divider"><hr /></span>
            <li class="nav-item @GetActive(PageHelper.ListHref(PageList.Category), NavLinkMatch.Prefix)">
                <NavLink href="@PageHelper.ListHref(PageList.Category)" Match="NavLinkMatch.Prefix">
                    <span class="bi bi-list" aria-hidden="true"></span>@PageList.Categories
                </NavLink>
            </li>
            <li class="nav-item @GetActive(PageHelper.ListHref(PageList.Expense), NavLinkMatch.Prefix)">
                <NavLink href="@PageHelper.ListHref(PageList.Expense)" Match="NavLinkMatch.Prefix">
                    <span class="bi bi-list" aria-hidden="true"></span>@PageList.Expenses
                </NavLink>
            </li>
        </ul>
    </nav>
</aside>