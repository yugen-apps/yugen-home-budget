@attribute [Route(PageConstants.HomeUrl)]
@using Yugen.HomeBudget.Shared.Contants

<PageTitle>Index</PageTitle>

<!-- ========== title-wrapper start ========== -->
<div class="title-wrapper pt-30">
    <div class="row align-items-center">
        <div class="col-md-6">
            <div class="title mb-30">
                <h2>@PageConstants.Home</h2>
            </div>
        </div>
        <!-- end col -->
        <div class="col-md-6">
            <div class="breadcrumb-wrapper mb-30">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="#0">Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            @PageConstants.Home
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
        <!-- end col -->
    </div>
    <!-- end row -->
</div>
<!-- ========== title-wrapper end ========== -->
<div class="row">
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card mb-30">
            <div class="icon purple">
                <i class="bi bi-cart"></i>
            </div>
            <div class="content">
                <h6 class="mb-10">New Orders</h6>
                <h3 class="text-bold mb-10">34567</h3>
                <p class="text-sm text-success">
                    <i class="bi bi-arrow-up"></i> +2.00%
                    <span class="text-gray">(30 days)</span>
                </p>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <!-- End Col -->
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card mb-30">
            <div class="icon success">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <div class="content">
                <h6 class="mb-10">Total Income</h6>
                <h3 class="text-bold mb-10">$74,567</h3>
                <p class="text-sm text-success">
                    <i class="bi bi-arrow-up"></i> +5.45%
                    <span class="text-gray">Increased</span>
                </p>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <!-- End Col -->
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card mb-30">
            <div class="icon primary">
                <i class="bi bi-credit-card"></i>
            </div>
            <div class="content">
                <h6 class="mb-10">Total Expense</h6>
                <h3 class="text-bold mb-10">$24,567</h3>
                <p class="text-sm text-danger">
                    <i class="bi bi-arrow-down"></i> -2.00%
                    <span class="text-gray">Expense</span>
                </p>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <!-- End Col -->
    <div class="col-xl-3 col-lg-4 col-sm-6">
        <div class="icon-card mb-30">
            <div class="icon orange">
                <i class="bi bi-person"></i>
            </div>
            <div class="content">
                <h6 class="mb-10">New User</h6>
                <h3 class="text-bold mb-10">34567</h3>
                <p class="text-sm text-danger">
                    <i class="bi bi-arrow-down"></i> -25.00%
                    <span class="text-gray"> Earning</span>
                </p>
            </div>
        </div>
        <!-- End Icon Cart -->
    </div>
    <!-- End Col -->
</div>
<!-- End Row -->
<div class="row">
    <div class="col-lg-12">
        <div class="card-style mb-30">
            <div class="
                    title
                    d-flex
                    flex-wrap
                    align-items-center
                    justify-content-between
                  ">
                <div class="left">
                    <h6 class="text-medium mb-30">Sales History</h6>
                </div>
                <div class="right">
                    <a href=""
                       class="main-btn primary-btn btn-hover btn-sm">
                        <i class="bi bi-plus mr-5"></i> Add
                    </a>
                    <!-- end select -->
                </div>
            </div>
            <!-- End Title -->
            <div class="table-responsive">
                <table class="table top-selling-table">
                    <thead>
                        <tr>
                            <th>
                                <h6 class="text-sm text-medium">Products</h6>
                            </th>
                            <th class="min-width">
                                <h6 class="text-sm text-medium">Category</h6>
                            </th>
                            <th class="min-width">
                                <h6 class="text-sm text-medium">Revenue</h6>
                            </th>
                            <th class="min-width">
                                <h6 class="text-sm text-medium">Status</h6>
                            </th>
                            <th>
                                <h6 class="text-sm text-medium text-end">Actions</h6>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <p class="text-sm">Bedroom</p>
                            </td>
                            <td>
                                <p class="text-sm">Interior</p>
                            </td>
                            <td>
                                <p class="text-sm">$345</p>
                            </td>
                            <td>
                                <span class="status-btn close-btn">Pending</span>
                            </td>
                            <td>
                                <div class="action justify-content-end">
                                    <button class="edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="text-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <!-- End Table -->
            </div>
        </div>
    </div>
    <!-- End Col -->
</div>
<!-- End Row -->
