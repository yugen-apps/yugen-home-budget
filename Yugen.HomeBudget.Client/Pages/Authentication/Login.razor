@attribute [Route(PageConstants.LoginUrl)]
@using Yugen.HomeBudget.Shared.Contants
@using Yugen.HomeBudget.Client.ViewModels.Authentication
@inject LoginViewModel ViewModel

<!-- ========== title-wrapper start ========== -->
<TitleComponent PageTitle="@PageConstants.Login"
                Title="@PageConstants.Login"
                Breadcrumb="@PageConstants.Login" />
<!-- ========== title-wrapper end ========== -->
<div class="row g-0 auth-row">
    <div class="col-lg-6">
        <div class="auth-cover-wrapper bg-primary-100">
            <div class="auth-cover">
                <div class="title text-center">
                    <h1 class="text-primary mb-10">Welcome Back</h1>
                    <p class="text-medium">
                        Sign in to your Existing account to continue
                    </p>
                </div>
                <div class="cover-image">
                    <img src="assets/images/auth/signin-image.svg" alt="" />
                </div>
                <div class="shape-image">
                    <img src="assets/images/auth/shape.svg" alt="" />
                </div>
            </div>
        </div>
    </div>
    <!-- end col -->
    <div class="col-lg-6">
        <div class="signin-wrapper">
            <div class="form-wrapper">
                <h6 class="mb-15">Sign In Form</h6>
                <p class="text-sm mb-25">
                    Start creating the best possible user experience for you customers.
                </p>
                <EditForm class="form-signin" OnValidSubmit="() => ViewModel.OnSubmit()" Model="ViewModel.LoginRequest">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-12">
                            <div class="input-style-1">
                                <label>User Name</label>
                                <InputText @bind-Value="ViewModel.LoginRequest.UserName" autofocus placeholder="Username" />
                                <ValidationMessage For="@(() => ViewModel.LoginRequest.UserName)" />
                            </div>
                        </div>
                        <!-- end col -->
                        <div class="col-12">
                            <div class="input-style-1">
                                <label>Password</label>
                                <InputText type="password" placeholder="Password" @bind-Value="ViewModel.LoginRequest.Password" />
                                <ValidationMessage For="@(() => ViewModel.LoginRequest.Password)" />
                            </div>
                        </div>
                        <!-- end col -->
                        <div class="col-xxl-6 col-lg-12 col-md-6">
                            <div class="form-check checkbox-style mb-30">
                                <InputCheckbox class="form-check-input" @bind-Value="@ViewModel.LoginRequest.RememberMe" />
                                <label class="form-check-label">
                                    Remember Me
                                </label>
                            </div>
                        </div>
                        <!-- end col -->
                        <!--
                        <div class="col-xxl-6 col-lg-12 col-md-6">
                        <div class="
                        text-start text-md-end text-lg-start text-xxl-end
                        mb-30
                        ">
                        <a href="#0" class="hover-underline">Forgot Password?</a>
                        </div>
                        </div>
                        -->
                        <!-- end col -->
                        <div class="col-12">
                            <div class="button-group d-flex justify-content-center flex-wrap">
                                <button class="main-btn primary-btn btn-hover w-100 text-center"
                                        type="submit">
                                    Sign In
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- end row -->
                    <div class="row">
                        <label class="text-danger">@ViewModel.Error</label>
                    </div>
                </EditForm>
                <div class="singin-option pt-40">
                    <p class="text-sm text-medium text-dark text-center">
                        Don’t have any account yet?
                        <a href="@PageConstants.RegisterUrl">Create an account</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
    <!-- end col -->
</div>
<!-- end row -->
    