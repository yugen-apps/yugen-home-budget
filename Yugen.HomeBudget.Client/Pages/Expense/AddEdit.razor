@attribute [Route(PageConstants.ExpenseAddUrl)]
@attribute [Route(PageConstants.ExpenseEditUrl)]
@using Yugen.HomeBudget.Client.Models
@using Yugen.HomeBudget.Client.ViewModels.Expense
@using Yugen.HomeBudget.Shared.Contants
@inject ExpenseAddEditViewModel ViewModel
<!-- AllowAnonymous / Authorize -->
@attribute [Authorize]

<!-- ========== title-wrapper start ========== -->
<TitleComponent PageTitle="@PageConstants.ExpenseTitle"
                Title="@PageHelper.AddEditTitle(PageConstants.ExpenseTitle, Id)"
                Breadcrumb="@PageConstants.ExpenseTitle" />
<!-- ========== title-wrapper end ========== -->
@if (ViewModel.Expense != null)
{
    <div class="row">
        <div class="col-lg-6">
            <EditForm Model="@ViewModel.Expense"
                  OnInvalidSubmit="(async () => await ViewModel.SubmitAsync(false))"
                  OnValidSubmit="(async () => await ViewModel.SubmitAsync(true))">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="card-style settings-card-2 mb-30">
                    <div class="row">
                        <div class="col-12">
                            <div class="input-style-1">
                                <label>Title</label>
                                <InputText @bind-Value="ViewModel.Expense.Title" placeholder="Title" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="input-style-1">
                                <label>Amount</label>
                                <InputNumber @bind-Value="ViewModel.Expense.Amount" placeholder="Amount" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="input-style-1">
                                <label>Date</label>
                                <InputDate @bind-Value="ViewModel.Expense.DateTimeOffset" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="select-style-1">
                                <label>Category</label>
                                <div class="select-position">
                                    <InputSelect @bind-Value="ViewModel.Expense.CategoryId"
                                             @bind-Value:after="ViewModel.CategoryChanged">
                                        @{
                                            if (ViewModel.CurrentCategory != null)
                                            {
                                                foreach (var category in ViewModel.Categories)
                                                {
                                                    <option value="@category.Id">@category.Title</option>
                                                }
                                            }
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="select-style-1">
                                <label>Sub Category</label>
                                <div class="select-position">
                                    <InputSelect @bind-Value="ViewModel.Expense.SubCategoryId">
                                        @{
                                            if (ViewModel.CurrentCategory != null)
                                            {
                                                foreach (var subCategory in ViewModel.CurrentCategory.SubCategoriesDto)
                                                {
                                                    <option value="@subCategory.Id">@subCategory.Title</option>
                                                }
                                            }
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <button disabled="@ViewModel.Busy"
                                    type="submit"
                                    class="main-btn primary-btn btn-hover">
                                Save
                            </button>
                            <button disabled="@ViewModel.Busy"
                                    class="main-btn warning-btn btn-hover"
                                    @onclick="() => ViewModel.CancelAsync()">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </EditForm>
            <!-- end card -->
        </div>
        <!-- end col -->
    </div>
}
@if (ViewModel.ConcurrencyError)
{
    <br />
    <div class="alert alert-danger">
        <p>
            The details have changed since it was last loaded. The updated fields are highlighted in the form.
            Please choose an option:
        </p>
        <p><b>Cancel</b> to lose your changes and keep the database version.</p>
        <p><b>Submit</b> to force an update with your version.</p>
    </div>
}
@if (ViewModel.Error)
{
    <br />
    <div class="alert alert-danger">Failed to update (@ViewModel.ErrorMessage).</div>
}
