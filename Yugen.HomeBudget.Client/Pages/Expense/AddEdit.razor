@attribute [Route(PageConstants.ExpenseAddUrl)]
@attribute [Route(PageConstants.ExpenseEditUrl)]
@using Yugen.HomeBudget.Client.Models
@using Yugen.HomeBudget.Shared.Contants
@inject EditSuccess EditSuccessState
<!-- AllowAnonymous / Authorize -->
@attribute [Authorize]

<!-- ========== title-wrapper start ========== -->
<TitleComponent PageTitle="@PageConstants.ExpenseTitle"
                Title="@PageHelper.AddEditTitle(PageConstants.ExpenseTitle, Id)"
                Breadcrumb="@PageConstants.ExpenseTitle" />
<!-- ========== title-wrapper end ========== -->
@if (ExpenseDto != null)
{
    <div class="row">
        <div class="col-lg-6">
            <EditForm Model="@ExpenseDto"
                  OnInvalidSubmit="(async () => await SubmitAsync(false))"
                  OnValidSubmit="(async () => await SubmitAsync(true))">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="card-style settings-card-2 mb-30">
                    <div class="row">
                        <div class="col-12">
                            <div class="input-style-1">
                                <label>Title</label>
                                <InputText @bind-Value="ExpenseDto.Title" placeholder="Title" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="input-style-1">
                                <label>Amount</label>
                                <InputNumber @bind-Value="ExpenseDto.Amount" placeholder="Amount" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="input-style-1">
                                <label>Date</label>
                                <InputDate @bind-Value="ExpenseDto.DateTimeOffset" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="select-style-1">
                                <label>Category</label>
                                <div class="select-position">
                                    <InputSelect @bind-Value="ExpenseDto.CategoryDto.Id">
                                        @foreach (var category in _categories)
                                        {
                                            if (ExpenseDto.CategoryDto.Id == category.Id)
                                            {
                                                <option value="@category.Id" selected="selected">@category.Title</option>
                                            }
                                            else
                                            {
                                                <option value="@category.Id">@category.Title</option>
                                            }
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="select-style-1">
                                <label>Sub Category</label>
                                <div class="select-position">
                                    <InputSelect @bind-Value="ExpenseDto.SubCategoryDto.Id">
                                        @{
                                            var currentCategory = _categories.FirstOrDefault(x => x.Id == ExpenseDto.CategoryDto.Id);
                                            if (currentCategory != null)
                                            {
                                                foreach (var subCategory in currentCategory.SubCategoriesDto)
                                                {
                                                    if (ExpenseDto.SubCategoryDto.Id == subCategory.Id)
                                                    {
                                                        <option value="@subCategory.Id" selected="selected">@subCategory.Title</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@subCategory.Id">@subCategory.Title</option>
                                                    }
                                                }
                                            }
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <button disabled="@_busy"
                                type="submit"
                                class="main-btn primary-btn btn-hover">
                                Save
                            </button>
                            <button disabled="@_busy"
                                class="main-btn warning-btn btn-hover"
                                @onclick="CancelAsync">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </EditForm>
            <!-- end card -->
        </div>
        <!-- end col -->
    </div>
}
@if (_concurrencyError)
{
    <br />
    <div class="alert alert-danger">
        <p>
            The contact details have changed since it was last loaded. The updated fields are highlighted in the form.
            Please choose an option:
        </p>
        <p><b>Cancel</b> to lose your changes and keep the database version.</p>
        <p><b>Submit</b> to force an update with your version.</p>
    </div>
}
@if (_error)
{
    <br />
    <div class="alert alert-danger">Failed to update the contact (@_errorMessage).</div>
}
