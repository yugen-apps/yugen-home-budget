@attribute [Route(PageConstants.ExpenseUrl)]
@using Yugen.HomeBudget.Shared.Contants
<!-- AllowAnonymous / Authorize -->
@attribute [Authorize]

<!-- ========== title-wrapper start ========== -->
<TitleComponent PageTitle="@PageConstants.ExpenseTitle"
                Title="@PageConstants.ExpenseTitle"
                Breadcrumb="@PageConstants.ExpenseTitle" />
<!-- ========== title-wrapper end ========== -->
@if (_expenses == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
    </div>
    <div class="row">
        <div class="card-style mb-30">
            <div class="title d-flex flex-wrap align-items-center justify-content-between ">
                <div class="left">
                    <a href="@PageConstants.ExpenseAddUrl"
                       class="main-btn primary-btn btn-hover btn-sm"
                       title="Add">
                        <i class="bi bi-plus mr-5"></i> Add
                    </a>
                </div>
                <PagerComponent PageIndex=@_paginatedList.PageIndex
                            TotalPages=@_paginatedList.TotalPages
                            OnClick="PageIndexChanged"
                            HasNextPage=@_paginatedList.HasNextPage
                            HasPreviousPage=@_paginatedList.HasPreviousPage />
            </div>
            <!-- End Title -->
            <div class="table-responsive">
                <table class="table top-selling-table">
                    <thead>
                        <tr>
                            <th>
                                <h6 class="text-sm text-medium">Date</h6>
                            </th>
                            <th class="min-width">
                                <h6 class="text-sm text-medium">Title</h6>
                            </th>
                            <th class="min-width">
                                <h6 class="text-sm text-medium">Amount</h6>
                            </th>
                            <th class="min-width">
                                <h6 class="text-sm text-medium">Category</h6>
                            </th>
                            <th class="min-width">
                                <h6 class="text-sm text-medium">Created On / Modified On</h6>
                            </th>
                            <th>
                                <h6 class="text-sm text-medium text-end">Actions</h6>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in _expenses)
                        {
                            <tr>
                                <td>
                                    <p class="text-sm">@GetDate(expense.DateTimeOffset)</p>
                                </td>
                                <td>
                                    <p class="text-sm">@expense.Title</p>
                                </td>
                                <td>
                                    <p class="text-sm">$ @expense.Amount</p>
                                </td>
                                <td>
                                    <span class="status-btn close-btn">@expense.CategoryDto.Title > @expense.SubCategoryDto.Title</span>
                                </td>
                                <td>
                                    <p class="text-sm">@GetDate(expense.CreatedOn)</p>
                                    <p class="text-sm">@GetDate(expense.LastModifiedOn)</p>
                                    <p class="text-sm">@expense.CreatedByApplicationUserId</p>
                                    <p class="text-sm">@expense.LastModifiedByApplicationUserId</p>
                                </td>
                                <td>
                                    <div class="action justify-content-end">

                                        <a href="@PageHelper.EditHref(PageConstants.ExpenseUrl, expense.Id)"
                                           class="main-btn warning-btn btn-hover btn-sm mr-10"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <DeleteComponent Id="@expense.Id"
                                                 DeleteCallback="@DeleteAsync" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!-- End Table -->
            </div>
        </div>
    </div>
}
