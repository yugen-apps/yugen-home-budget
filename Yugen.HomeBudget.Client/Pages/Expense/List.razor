@page "/expense/list"
<!-- AllowAnonymous / Authorize -->
@attribute [AllowAnonymous]

<PageTitle>@PageList.Expenses</PageTitle>

<!-- ========== title-wrapper start ========== -->
<div class="title-wrapper pt-30">
    <div class="row align-items-center">
        <div class="col-md-6">
            <div class="title mb-30">
                <h2>@PageList.Expenses</h2>
            </div>
        </div>
        <!-- end col -->
        <div class="col-md-6">
            <div class="breadcrumb-wrapper mb-30">
                <nav aria-label="breadcrumb">
                    <a href="@PageHelper.AddHref(PageList.Expense)"
                       class="main-btn primary-btn btn-hover btn-sm"
                       title="Add">
                        <i class="bi bi-plus mr-5"></i> Add
                    </a>
                </nav>
            </div>
        </div>
        <!-- end col -->
    </div>
    <!-- end row -->
</div>
<!-- ========== title-wrapper end ========== -->
@if (_expenses == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table top-selling-table">
            <thead>
                <tr>
                    <th>
                        <h6 class="text-sm text-medium">Date</h6>
                    </th>
                    <th class="min-width">
                        <h6 class="text-sm text-medium">Title</h6>
                    </th>
                    <th class="min-width">
                        <h6 class="text-sm text-medium">Amount</h6>
                    </th>
                    <th class="min-width">
                        <h6 class="text-sm text-medium">Category</h6>
                    </th>
                    <th>
                        <h6 class="text-sm text-medium text-end">Actions</h6>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var expense in _expenses)
                {
                    <tr>
                        <td>
                            <p class="text-sm">@GetDate(expense.DateTimeOffset)</p>
                        </td>
                        <td>
                            <p class="text-sm">@expense.Title</p>
                        </td>
                        <td>
                            <p class="text-sm">$ @expense.Amount</p>
                        </td>
                        <td>
                            <span class="status-btn close-btn">@expense.CategoryDto.Title > @expense.SubCategoryDto.Title</span>
                        </td>
                        <td>
                            <div class="action justify-content-end">

                                <a href="@PageHelper.EditHref(PageList.Expense, expense.Id)"
                                   class="main-btn warning-btn btn-hover btn-sm mr-10"
                                   title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <DeleteControl Id="@expense.Id"
                                       DeleteCallback="@DeleteAsync" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- End Table -->
    </div>
}
