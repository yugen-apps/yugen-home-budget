@using Yugen.HomeBudget.Server.Models.Navigation
@if (Routes.IsAccount)
{
    <MudIconButton Color="Color.Inherit"
                   Href="/"
                   Icon="@Icons.Material.Filled.Home" />
}
else
{
    @* https://www.fluentui-blazor.net/ProfileMenu *@
    <MudMenu AnchorOrigin="Origin.TopLeft"
             Size="@Size.Large"
             TransformOrigin="Origin.BottomLeft">
        <ActivatorContent>
            <AuthorizeView Context="authorizeContext">

                <Authorized>
                    <MudAvatar>
                        <MudImage Src="@Avatar"
                                  @onclick="@context.ToggleAsync" />
                    </MudAvatar>
                </Authorized>

                <NotAuthorized>
                    <MudAvatar>
                        <MudIconButton Color="Color.Inherit"
                                       Icon="@Icons.Material.Filled.Settings"
                                       OnClick="@context.ToggleAsync" />
                    </MudAvatar>
                </NotAuthorized>

            </AuthorizeView>
        </ActivatorContent>
        <ChildContent>
            <AuthorizeView>

                <Authorized>
                    <MudCard class="pa-2">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar>
                                    <MudImage Src="@Avatar" />
                                </MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.h6">@GivenName</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2">@UserName</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                    </MudCard>
                    <MudMenuItem Href="/Account/Manage"
                                 Icon="@Icons.Material.Filled.Settings"
                                 Label="Manage" />
                    <MudDivider />
                    <MudMenuItem Icon="@ThemeIcon"
                                 Label="@ThemeLabel"
                                 OnClick="@ToggleTheme" />
                    <MudDivider />
                    <MudMenu Label="Debug"
                             StartIcon="@Icons.Material.Filled.BugReport">
                        <MudMenuItem Href="@MenuConstants.SettingsInfoMenuItem.Path"
                                     Label="@MenuConstants.SettingsInfoMenuItem.Title"
                                     Icon="@Icons.Material.Filled.Info" />
                        <MudDivider />
                        <MudMenuItem Href="https://www.mudblazor.com/docs/overview"
                                     Label="Docs"
                                     Target="_blank"
                                     Icon="@Icons.Material.Filled.Link" />
                        <MudDivider />
                        <MudMenuItem Href="https://www.mudblocks.cc"
                                     Label="Demo"
                                     Target="_blank"
                                     Icon="@Icons.Material.Filled.Link" />
                    </MudMenu>
                    <MudDivider />
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@Routes.CurrentUrl" />
                        <button type="submit" class="mud-nav-link mud-ripple">
                            <MudIcon Class="mr-3"
                                     Color="Color.Error"
                                     Icon="@Icons.Material.Filled.Logout" />
                            Logout
                        </button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <MudMenuItem Href="/Account/Login"
                                 Icon="@Icons.Material.Filled.Login"
                                 Label="Log In" />
                    <MudDivider />
                    <MudMenuItem Href="/Account/Register"
                                 Icon="@Icons.Material.Filled.PlusOne"
                                 Label="Register"
                                 Disabled="true" />
                </NotAuthorized>

            </AuthorizeView>
        </ChildContent>
    </MudMenu>
}

										 
