@using Yugen.HomeBudget.Server.Models.Navigation

<MudNavMenu>
    <MudDivider Class="my-2" />
    @foreach (var menuItem in MenuConstants.MenuItems)
    {
        @if (menuItem.IsParent)
        {
            <MudNavGroup Title="@menuItem.Title"
                         Icon="@menuItem.Icon">
                @foreach (var menuSubItem in menuItem.MenuSubItems)
                {
                    <AuthorizeView Policy="@menuSubItem.Policy">
                        <Authorized>
                            <MudNavLink Href="@menuSubItem.Path"
                                        Icon="@menuItem.Icon">
                                @menuSubItem.Title
                            </MudNavLink>
                        </Authorized>
                    </AuthorizeView>
                }
            </MudNavGroup>
        }
        else
        {
            <AuthorizeView Policy="@menuItem.Policy">
                <Authorized>
                    <MudNavLink Href="@menuItem.Path"
                                Icon="@menuItem.Icon">
                        @menuItem.Title
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>
        }
    }
</MudNavMenu>
<MudDivider Class="my-2" />
<MudStack AlignItems="AlignItems.End" Row="true">
    <MudNavGroup Title="Debug"
                 Icon="@Icons.Material.Filled.Settings">
        @foreach (var menuItem in MenuConstants.SettingsMenuItems)
        {
            <MudNavLink Href="@menuItem.Path"
                        Target="@menuItem.Target">
                @menuItem.Title
            </MudNavLink>
        }
    </MudNavGroup>
</MudStack>

