@using Yugen.HomeBudget.Server.Navigation

<MudNavMenu>
	<MudDivider Class="my-2" />
	@foreach (var menuItem in MenuConstants.MenuItems)
	{
		@if (menuItem.IsParent)
		{
			<MudNavGroup Title="@menuItem.Title"
						 Icon="@Icons.Material.Filled.Settings">
				@foreach (var menuSubItem in menuItem.MenuSubItems)
				{
					<AuthorizeView Policy="@menuSubItem.Policy">
						<Authorized>
							<MudNavLink Href="@menuSubItem.Path"
										Icon="@menuItem.Icon">
								@menuSubItem.Title
							</MudNavLink>
						</Authorized>
					</AuthorizeView>
				}
			</MudNavGroup>
		}
		else
		{
			<AuthorizeView Policy="@menuItem.Policy">
				<Authorized>
					<MudNavLink Href="@menuItem.Path"
								Icon="@menuItem.Icon">
						@menuItem.Title
					</MudNavLink>
				</Authorized>
			</AuthorizeView>
		}
	}
</MudNavMenu>
<MudDivider Class="my-2" />
<MudStack AlignItems="AlignItems.End" Row="true">
	<MudNavGroup Title="Debug"
				 Icon="@Icons.Material.Filled.Settings">
		<MudNavLink Href="@MenuConstants.InfoPath">
			@MenuConstants.InfoPath
		</MudNavLink>
		<MudNavLink Href="https://www.mudblazor.com/docs/overview"
					Target="_blank">
			Docs
		</MudNavLink>
		<MudNavLink Href="https://mudblocks.cc/"
					Target="_blank">
			Demo
		</MudNavLink>
		@* <MudNavLink Href="/auth">
		Auth Required
		</MudNavLink> *@
	</MudNavGroup>
</MudStack>

