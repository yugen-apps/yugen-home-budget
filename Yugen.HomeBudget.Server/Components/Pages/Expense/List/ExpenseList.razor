@using Microsoft.AspNetCore.Authorization
@using Yugen.HomeBudget.Application.Models.Expense
@using Yugen.HomeBudget.Server.Components.Shared
@using Yugen.HomeBudget.Server.Models
@using Yugen.HomeBudget.Server.Models.Navigation
@using Yugen.HomeBudget.Server.ViewModels.Expense
@attribute [Route(MenuConstants.ExpensePath)]
@attribute [Authorize]
@inject ExpenseListViewModel ViewModel

<MudGrid>

	<MudOverlay Visible="ViewModel.IsLoading" DarkBackground="true" Absolute="true">
		<MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large" />
	</MudOverlay>

	<MudItem xs="12">
		<HeaderComponent PageTitle="@MenuConstants.ExpenseMenuItem.Title"
						 Title="@MenuConstants.ExpenseMenuItem.Title"
						 Breadcrumb="@MenuConstants.ExpenseMenuItem.Title" />
	</MudItem>

	<MudItem xs="12">
		<MudCard Elevation="8">
			<MudCardHeader>

				<MudButton Color="Color.Secondary"
						   Href="@($"{MenuConstants.ApiExport}/{ViewModel.SelectedYear}")"
						   StartIcon="@Icons.Material.Filled.FileDownload"
						   Variant="Variant.Filled">
					Export
				</MudButton>
				<MudSpacer />
				<MudSelect Label="Month"
						   T="int"
						   Value="ViewModel.SelectedMonth"
						   ValueChanged="(month) => ViewModel.DateChanged(month, null)">
					@foreach (var month in ViewModel.Months)
					{
						<MudSelectItem Value="month">@month</MudSelectItem>
					}
				</MudSelect>
				<MudSpacer />
				<MudSelect Label="Year"
						   T="int"
						   Value="ViewModel.SelectedYear"
						   ValueChanged="(year) => ViewModel.DateChanged(null, year)">
					@foreach (var year in ViewModel.Years)
					{
						<MudSelectItem Value="year">@year</MudSelectItem>
					}
				</MudSelect>

			</MudCardHeader>

			<MudCardContent>
				<MudDataGrid @ref="DataGrid"
							 T="ResponseExpenseDto"
							 ServerData="ViewModel.ServerReload"
							 Bordered="true"
							 Dense="true">
					<ToolBarContent>
						<MudText Typo="Typo.h6">Expenses</MudText>
						<MudSpacer />
						<MudButtonGroup Class="ma-0 pa-0"
										Color="Color.Success"
										Variant="Variant.Filled">
							<MudButton Color="Color.Primary"
									   Href="@MenuConstants.ExpenseDetailsPath"
									   StartIcon="@Icons.Material.Filled.Add"
									   Variant="Variant.Filled">
								Add New Item
							</MudButton>
						</MudButtonGroup>
					</ToolBarContent>
					<Columns>
						<PropertyColumn Property="x => x.DateTimeOffset"
										Title="@nameof(ResponseExpenseDto.DateTimeOffset)"
										Format="g" />
						<PropertyColumn Property="x => x.Title"
										Title="@nameof(ResponseExpenseDto.Title)" />
						<PropertyColumn Property="x => x.Amount"
										Title="@nameof(ResponseExpenseDto.Amount)" />
						<PropertyColumn Property="x => x.Accrued"
										Title="@nameof(ResponseExpenseDto.Accrued)" />
						<PropertyColumn Property=" x=> x.CategoryDto.Title"
										Title="Category" />
						<PropertyColumn Property="x => x.SubCategoryDto.Title"
										Title="SubCategory" />
						<PropertyColumn Property="x => x.CreatedOn"
										Title="@nameof(ResponseExpenseDto.CreatedOn)"
										Format="d" />
						<PropertyColumn Property="x => x.LastModifiedOn"
										Title="@nameof(ResponseExpenseDto.LastModifiedOn)"
										Format="d" />
						@* 
						<PropertyColumn Property="x => x.CreatedByApplicationUserId"
										Title="@nameof(ResponseExpenseDto.CreatedByApplicationUserId)" />
						<PropertyColumn Property="x => x.LastModifiedByApplicationUserId"
										Title="@nameof(ResponseExpenseDto.LastModifiedByApplicationUserId)" /> 
						*@
						<TemplateColumn CellClass="d-flex justify-between">
							<CellTemplate>
								<MudIconButton Size="@Size.Small"
											   Icon="@Icons.Material.Outlined.Edit"
											   Href="@($"{MenuConstants.ExpenseDetailsPath}/{context.Item.Id}")" />
								<MudIconButton Size="@Size.Small"
											   Icon="@Icons.Material.Outlined.Delete"
											   OnClick="@(() => ViewModel.ShowDeleteConfirmMessage(context.Item.Id))" />
							</CellTemplate>
						</TemplateColumn>
					</Columns>
					<PagerContent>
						<MudDataGridPager T="ResponseExpenseDto"
										  PageSizeOptions=@( new int[] { Constants.PageSize, Constants.PageSizeSmall } ) />
					</PagerContent>
				</MudDataGrid>
			</MudCardContent>
		</MudCard>
	</MudItem>
</MudGrid>
