@attribute [Route(MenuConstants.CategoriesPath)]
@attribute [Authorize]
@using Blazorise.DataGrid
@using Blazorise.LoadingIndicator
@using Microsoft.AspNetCore.Authorization
@using Yugen.HomeBudget.Server.Components
@using Yugen.HomeBudget.Server.Components.Shared
@using Yugen.HomeBudget.Server.Helpers
@using Yugen.HomeBudget.Server.Navigation
@using Yugen.HomeBudget.Server.ViewModels.Category
@using Yugen.HomeBudget.Shared.Models.Category
@inject CategoryListViewModel ViewModel

<HeaderComponent PageTitle="@MenuConstants.CategoriesMenuItem.Title"
                Title="@MenuConstants.CategoriesMenuItem.Title"
                Breadcrumb="@MenuConstants.CategoriesMenuItem.Title" />

<LoadingIndicator @bind-Visible="@ViewModel.IsLoading">
    <Row>
        <Column ColumnSize="ColumnSize.Is12">
            <Card Margin="Margin.Is4.FromBottom"
                  Shadow="Shadow.Default">
                <CardBody>
                    <Media>
                        <MediaLeft>
                            <Button Color="Color.Primary"
                                    Type="ButtonType.Link"
                                    To="@MenuConstants.CategoryPath">
                                <Icon Name="IconName.PlusSquare" />
                                Add
                            </Button>
                        </MediaLeft>
                        <MediaBody></MediaBody>
                        <MediaRight>
                            <PagerComponent CurrentPage=@ViewModel.PaginatedList.PageIndex.ToString()
                                            PageItems=@ViewModel.PaginatedList.TotalPages
                                            OnClick="(newPageNumber) => ViewModel.PageIndexChanged(newPageNumber)" />

                        </MediaRight>
                    </Media>
                </CardBody>
            </Card>
        </Column>

        @foreach (var category in ViewModel.Categories)
        {
            <Column ColumnSize="ColumnSize.Is3.OnDesktop"
                    Margin="Margin.Is4.FromBottom">
                <Card Shadow="Shadow.Default"
                      Height="Height.Is100">
                    <CardHeader>
                        <Icon IconSize="IconSize.Large"
                              Margin="Margin.Is1.FromEnd"
                              Name="@IconHelper.GetIconName(category.Icon)" />
                        @category.Title
                    </CardHeader>
                    <CardBody>
                        <CardText>
                            <DataGrid TItem="SubCategoryDto"
                                      Data="@category.SubCategoriesDto"
                                      Responsive>
                                <DataGridColumn Field="@nameof(SubCategoryDto.Title)" Caption="Sub Categories" />
                            </DataGrid>
                        </CardText>
                    </CardBody>
                    <CardFooter>
                        <Button Color="Color.Warning"
                                Type="ButtonType.Link"
                                To=@($"{MenuConstants.CategoryPath}/{category.Id}")>
                            <Icon Name="IconName.Edit" />
                        </Button>
                        <Button Color="Color.Danger"
                                Clicked="() => ViewModel.ShowDeleteConfirmMessage(category.Id)">
                            <Icon Name="IconName.Delete" />
                        </Button>
                    </CardFooter>
                </Card>
            </Column>
        }

    </Row>
</LoadingIndicator>
