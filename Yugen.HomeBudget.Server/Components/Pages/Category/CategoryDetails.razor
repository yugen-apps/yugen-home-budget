@using Microsoft.AspNetCore.Authorization
@using Yugen.HomeBudget.Application.Models.Category
@using Yugen.HomeBudget.Server.Components.Shared
@using Yugen.HomeBudget.Server.Navigation
@using Yugen.HomeBudget.Server.ViewModels.Category
@attribute [Route(MenuConstants.CategoryDetailsPath)]
@attribute [Route(MenuConstants.CategoryDetailsRoute)]
@attribute [Authorize]
@inject CategoryDetailsViewModel ViewModel

<MudGrid>

	<MudItem xs="12">
		<HeaderComponent PageTitle="@MenuConstants.CategoryMenuItem.Title"
						 Title="@MenuConstants.AddEditTitle(MenuConstants.CategoryMenuItem.Title, Id)"
						 Breadcrumb="@MenuConstants.CategoryMenuItem.Title" />
	</MudItem>

	<MudItem xs="12">
		@if (ViewModel.Model != null)
		{
			<MudCard Elevation="8">
				<MudCardHeader>
					Add/Edit Cateogry
				</MudCardHeader>

				<MudCardContent>
					<MudForm @ref="ViewModel.Form" 
							 @bind-IsValid="@ViewModel.IsFormValid"
							 Model="ViewModel.Model">

						<MudTextField Autofocus
									  Label="Title"
									  Placeholder="Title"
									  Required="true"
									  @bind-Value="@ViewModel.Model.Title" />

						<MudField Label="Icon"
								  Variant="Variant.Text">
							<MudIconButton Color="Color.Primary"
										   Icon="@ViewModel.Model.IconCode"
										   Variant="Variant.Filled"
										   OnClick="@(() => ViewModel.ShowIconsDialog(ViewModel.Model.IconName))" />
						</MudField>

						<MudDataGrid @ref="_elementGrid"
									 T="SubCategoryDto"
									 Items="@ViewModel.Model?.SubCategoriesDto"
									 EditMode="DataGridEditMode.Form"
									 EditTrigger="DataGridEditTrigger.Manual"
									 Bordered="true"
									 Dense="true"
									 ReadOnly="false"
									 CommittedItemChanges="@ViewModel.CommittedItemChanges">
							<ToolBarContent>
								<MudText Typo="Typo.h6">Sub Categories</MudText>
								<MudSpacer />
								<MudButtonGroup Class="ma-0 pa-0"
												Color="Color.Success"
												Variant="Variant.Filled">
									<MudButton OnClick="NewItemAsync"
											   StartIcon="@Icons.Material.Filled.Add">
										Add New Item
									</MudButton>
								</MudButtonGroup>
							</ToolBarContent>
							<Columns>
								<PropertyColumn Property="x => x.Title"
												Title="@nameof(SubCategoryDto.Title)"
												Required />

								<TemplateColumn CellClass="d-flex justify-between">
									<CellTemplate>
										<MudIconButton Size="@Size.Small"
													   Icon="@Icons.Material.Outlined.Edit"
													   OnClick="@context.Actions.StartEditingItemAsync" />
										<MudIconButton Size="@Size.Small"
													   Icon="@Icons.Material.Outlined.Delete"
													   OnClick="@(() => ViewModel.ShowDeleteConfirmMessage(context.Item))" />
									</CellTemplate>
								</TemplateColumn>
							</Columns>
						</MudDataGrid>

					</MudForm>
				</MudCardContent>

				<MudCardActions>
					<MudButton Color="Color.Primary"
							   Variant="Variant.Filled"
							   OnClick="@ViewModel.OnSubmit">
						Save
					</MudButton>
					<MudButton Color="Color.Warning"
							   Class="ms-2"
							   Variant="Variant.Filled"
							   OnClick="@ViewModel.CancelAsync">
						Cancel
					</MudButton>
					<MudText>
						@if (ViewModel.IsAlertVisible)
						{
							<MudAlert Severity="Severity.Error"
									  ShowCloseIcon="true"
									  CloseIconClicked="(() => ViewModel.IsAlertVisible = false )">
								@ViewModel.Error
							</MudAlert>
						}
					</MudText>

				</MudCardActions>
			</MudCard>
		}	

	</MudItem>
</MudGrid>
