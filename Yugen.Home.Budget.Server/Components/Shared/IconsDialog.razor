<MudDialog>
	<TitleContent>
		<MudText Typo="Typo.h6">
			<MudIcon Icon="@Icons.Material.Filled.Add"
					 Class="mr-3" />
			Add
		</MudText>
	</TitleContent>
	<DialogContent>
		<MudGrid>
			@foreach (var icon in MudIconList)
			{
				<MudItem xs="2">
					<MudIconButton OnClick="() => SetIcon(icon.Name)"
								   Color="@IsActive(icon.Name)"
								   Icon="@icon.Code" />
					<MudText Typo="Typo.body2">@icon.Category</MudText>
					<MudText Typo="Typo.body2">@icon.Name</MudText>
				</MudItem>
			}
		</MudGrid>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel"
				   Variant="Variant.Filled">
			Cancel
		</MudButton>
		<MudButton Color="Color.Primary"
				   OnClick="Submit"
				   StartIcon="@Icons.Material.Filled.Save"
				   Variant="Variant.Filled">
			Save
		</MudButton>
	</DialogActions>
</MudDialog>