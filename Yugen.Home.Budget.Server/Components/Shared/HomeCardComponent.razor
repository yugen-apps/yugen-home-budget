<MudCard Elevation="8">
    <MudCardHeader>
        <MudCardHeader>
            <CardHeaderAvatar>
                <MudAvatar Color="Color.Secondary">
                    <MudIcon Icon="@IconName" />
                </MudAvatar>
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.body1">@Header</MudText>
                <MudChip T="string"
                         Color="Color.Primary"
                         Icon="@Icon">
                    @Percentage %
                </MudChip>
            </CardHeaderContent>
        </MudCardHeader>
    </MudCardHeader>
    <MudCardContent>
        <MudStack>
        <MudChip T="string"
                 Color="Color.Info">
            Current: @(string.Format("{0:C}", Current))
        </MudChip>
        <MudChip T="string"
                 Color="Color.Tertiary">
            Previous: @(string.Format("{0:C}", CompareTo))
        </MudChip>
        </MudStack>
    </MudCardContent>
</MudCard>
