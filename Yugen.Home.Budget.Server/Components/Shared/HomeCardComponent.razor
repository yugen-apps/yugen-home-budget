<MudCard Elevation="8">
	<MudCardHeader>
		<MudCardHeader>
			<CardHeaderAvatar>
				<MudAvatar Color="Color.Secondary">
					<MudIcon Icon="@IconName" />
				</MudAvatar>
			</CardHeaderAvatar>
			<CardHeaderContent>
				<MudText Typo="Typo.body2">@Header</MudText>
				<MudText Typo="Typo.body2">@Footer</MudText>
			</CardHeaderContent>
		</MudCardHeader>
	</MudCardHeader>
	<MudCardActions>
		<MudChip T="string">$ @Current</MudChip>
		<MudChip T="string"
				 Color="Color.Primary"
				 Icon="@Icon">
			@Percentage %
		</MudChip>
	</MudCardActions>
</MudCard>
