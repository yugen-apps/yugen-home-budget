@using Microsoft.AspNetCore.Authorization
@using Yugen.Common.Blazor.Components
@using Yugen.Home.Budget.Application.Models.Category
@using Yugen.Home.Budget.Server.Models.Navigation
@using Yugen.Home.Budget.Server.ViewModels.Expense
@attribute [Route(MenuConstants.ExpenseDetailsPath)]
@attribute [Route(MenuConstants.ExpenseDetailsRoute)]
@attribute [Authorize]
@inject ExpenseDetailsViewModel ViewModel

<MudGrid>

    <MudItem xs="12">
        <HeaderComponent PageTitle="@MenuConstants.ExpenseMenuItem.Title"
                         Title="@MenuConstants.AddEditTitle(MenuConstants.ExpenseMenuItem.Title, Id)"
                         Breadcrumb="@MenuConstants.ExpenseMenuItem.Title" />
    </MudItem>

    <MudItem xs="12">
        @if (ViewModel.Model != null)
        {
            <MudCard Elevation="8">
                <MudCardHeader>
                    Add/Edit Expense
                </MudCardHeader>

                <MudCardContent>
                    <MudForm @bind-IsValid="ViewModel.IsFormValid"
                             ValidationDelay="0"
                             Model="ViewModel.Model">
                        <MudTextField Autofocus
                                      Label="Title"
                                      Placeholder="Title"
                                      Required="true"
                                      @bind-Value="@ViewModel.Model.Title" />

                        <MudTextField T="decimal?"
                                      Adornment="Adornment.Start"
                                      AdornmentColor="Color.Primary"
                                      AdornmentIcon="@Icons.Material.Filled.Euro"
                                      Label="Amount"
                                      Placeholder="0"
                                      Required="true"
                                      @bind-Value="@ViewModel.Model.Amount" />

                        <MudDatePicker Label="Date"
                                       Required="true"
                                       @bind-Date="@ViewModel.Model.DateTime" />

                        <MudTextField T="decimal"
                                      Adornment="Adornment.Start"
                                      AdornmentColor="Color.Primary"
                                      AdornmentIcon="@Icons.Material.Filled.Euro"
                                      Label="Accrued"
                                      Placeholder="0"
                                      @bind-Value="@ViewModel.Model.Accrued" />
	
                        <MudSelect T="ResponseCategoryDto"
                                   AnchorOrigin="Origin.TopCenter"
                                   Label="Category"
                                   Placeholder="Please Select"
                                   Required="true"
                                   TransformOrigin="Origin.BottomCenter"
                                   @bind-Value="ViewModel.Model.SelectedCategory"
                                   @bind-Value:after="ViewModel.CategoryChanged">
                            @foreach (var category in ViewModel.Model.Categories)
                            {
                                <MudSelectItem Value="category">
                                    @category.Title
                                </MudSelectItem>
                            }
                        </MudSelect>

                        @if (ViewModel.Model.SubCategories != null)
                        {
                            <MudSelect T="SubCategoryDto"
                                       AnchorOrigin="Origin.TopCenter"
                                       Label="SubCategory"
                                       Placeholder="Please Select"
                                       TransformOrigin="Origin.BottomCenter"
                                       Required="true"
                                       @bind-Value="ViewModel.Model.SelectedSubCategory">
                                @foreach (var subCategory in ViewModel.Model.SubCategories)
                                {
                                    <MudSelectItem Value="subCategory">
                                        @subCategory.Title
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }

                    </MudForm>
                </MudCardContent>

                <MudCardActions>
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick="@ViewModel.OnSubmit">
                        Save
                    </MudButton>
                    <MudButton Color="Color.Warning"
                               Class="ms-2"
                               Variant="Variant.Filled"
                               OnClick="@ViewModel.CancelAsync">
                        Cancel
                    </MudButton>
                    <MudText>
                        @if (ViewModel.IsAlertVisible)
                        {
                            <MudAlert Severity="Severity.Error"
                                      ShowCloseIcon="true"
                                      CloseIconClicked="(() => ViewModel.IsAlertVisible = false )">
                                @ViewModel.Error
                            </MudAlert>
                        }
                    </MudText>
                </MudCardActions>
            </MudCard>
        }
    </MudItem>
</MudGrid>
